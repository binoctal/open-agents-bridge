# Update intent for the runner image (add-cloud-executor 4.3).
#
# These tags are what a human WANTS; they are never used by a build. Run
# ./build.sh --update to resolve them into versions.lock (the only file the
# build reads). CLI engine versions must be exact -- `latest` is forbidden by
# the supply-chain requirement (spec sandbox-security-baseline: 镜像供应链),
# and --update refuses to resolve a floating npm spec.
NODE_IMAGE_TAG=node:22-alpine
CLAUDE_CODE_VERSION=2.1.266
BRIDGE_VERSION=0.12.0
